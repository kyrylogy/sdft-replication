-r() { echo "  + GPU=$GPU ./run.sh $*"; if ! GPU="$GPU" ./run.sh "$@"; then FAILED+=("$*"); echo "  [FAIL] $*"; fi; }
+# SEEDS='' : the tier driver seeds each call itself via --set; run.sh's own SEEDS loop
